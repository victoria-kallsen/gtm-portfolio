---
import Base from '../layouts/Base.astro';

// TODO: replace with real booking link (Cal.com / Calendly)
const bookingUrl = '/#contact';

const phases = [
  {
    n: 1,
    name: 'ICP and signals',
    when: 'Week 1',
    what: 'We look at your best customers and recent closed-won deals to pin down who buys and what was happening at the company right before they did. That becomes a short list of signals worth watching, plus the ones that mean "not yet".',
    get: 'A one-page ICP and signal spec: the signals, how many points each is worth, and what disqualifies an account.',
    need: 'A 60-minute kickoff, read access to your CRM, and 10 to 20 customers you wish you had more of.',
  },
  {
    n: 2,
    name: 'Account sourcing',
    when: 'Weeks 1–2',
    what: 'I build the target list from sources you already have, like Sales Navigator searches, your CRM, public job boards and funding and leadership news. It is checked against your CRM so reps never chase an open deal or a current customer. A scheduled job keeps adding new companies that fit.',
    get: 'A clean, deduplicated account list, an import path for new accounts, and a recurring finder that tops it up.',
    need: 'Your saved Sales Navigator searches and any lists you already trust.',
  },
  {
    n: 3,
    name: 'Signal checks and scoring',
    when: 'Week 2',
    what: 'Every account is checked on a schedule for the signals from phase 1: new sales roles on its public job board, a recent raise, a new sales leader. Each one adds or removes points, so every score comes with a plain-English reason.',
    get: 'A daily refresh, a transparent scoring model, and A/B/C tiers that decide who gets contacted first.',
    need: 'Agreement on the weights. We will revisit them once replies come in.',
  },
  {
    n: 4,
    name: 'Contact capture',
    when: 'Week 2',
    what: 'We set a rule for who to contact at each account, for example the most senior sales leader, else a founder. Reps save the right person in one click from a LinkedIn or Sales Navigator page they are already looking at, and AI fills in the details. Any email address is verified before it is used.',
    get: 'Contact rules and a one-click capture tool your reps actually use.',
    need: 'Fifteen minutes with each rep to set it up.',
  },
  {
    n: 5,
    name: 'Messaging and drafts',
    when: 'Weeks 2–3',
    what: 'Each message opens with the actual reason you are reaching out, so a new-leader account gets a different note than a just-raised one. Drafts are written for every account in the queue, sized to the channel, like the 300-character LinkedIn connection note.',
    get: 'A message library keyed to each signal, with follow-ups, and a draft waiting for every account.',
    need: 'Your proof points and the voice you want reps to sound like.',
  },
  {
    n: 6,
    name: 'Sending setup and deliverability',
    when: 'Weeks 2–4, in parallel',
    what: 'If email is part of the plan, it goes out from separate sending domains, never your main one. I set up SPF, DKIM and DMARC, warm the inboxes, cap daily volume and handle bounces and opt-outs. Warmup takes a few weeks, so this starts early. LinkedIn stays manual: reps send every request and message themselves.',
    get: 'Warmed sending domains, documented volume limits, and a setup that protects your main domain.',
    need: 'Approval to buy a few domains and mailboxes.',
  },
  {
    n: 7,
    name: 'Tracking',
    when: 'Week 3',
    what: 'Every touch is logged in one click, and follow-ups come due on a set cadence so nothing slips. Results are broken down by signal, so you can see which reasons to reach out actually get replies.',
    get: 'A daily "who to contact today" view and a weekly view of sends, accepts, replies and meetings by signal.',
    need: 'Agreement on what counts as a meeting.',
  },
  {
    n: 8,
    name: 'Launch and iterate',
    when: 'Week 4, then ongoing',
    what: 'Reps start sending from the daily queue. Each week we look at what got replies, reweight the scoring, retire messages that fall flat, and add signals that show up in the wins.',
    get: 'A short weekly review and a running change log, so the system keeps getting sharper instead of going stale.',
    need: '30 minutes a week with whoever owns outbound.',
  },
];

const flow = [
  { label: 'Find', items: ['Sales Navigator searches', 'Public job boards', 'Funding and leadership news'] },
  { label: 'Store', items: ['Account database', 'Deduped on import'] },
  { label: 'Check', items: ['Daily scheduled refresh', '12 job board systems'] },
  { label: 'Score', items: ['Points per signal', 'Reason on every account'] },
  { label: 'Draft', items: ['Message per signal', 'Follow-up cadence'] },
  { label: 'Send', items: ['By hand, from a daily queue'] },
  { label: 'Learn', items: ['Every touch logged', 'Replies by signal'] },
];

const stages = [
  {
    name: 'Audit',
    length: 'About 1–2 weeks',
    body: 'Phase 1, plus a review of the tools and data you already have. You come out with the ICP and signal spec and a build plan you could hand to anyone.',
  },
  {
    name: 'Build',
    length: 'About 2–3 weeks',
    body: 'Phases 2 through 7. The engine is built in your accounts, on your stack where it makes sense, and your team is trained on it.',
  },
  {
    name: 'Run and improve',
    length: 'Monthly, optional',
    body: 'Phase 8. The weekly review, new signals, scoring changes, and fixes when a source changes.',
  },
];

const faqs = [
  {
    q: 'Do we need Clay, Apollo or another data tool?',
    a: 'Not necessarily. Many of the best signals, like hiring on public job boards, are free to check. If you already pay for a tool, I build on it. If not, I only add one when it earns its cost.',
  },
  {
    q: 'Will this automate LinkedIn?',
    a: 'No. Nothing browses, scrapes or sends on LinkedIn by itself. Reps send every request and message, and the system makes sure they know who to contact and what to say.',
  },
  {
    q: 'Who owns it when you are done?',
    a: 'You do. The code, data and accounts are yours, documented well enough that your team or a future hire can run and change it.',
  },
  {
    q: 'How much of our time does it take?',
    a: 'A kickoff, some rep setup time, and about 30 minutes a week. I do the building.',
  },
  {
    q: 'We already have some of this. Do we start over?',
    a: 'No. The audit maps what to keep, what to fix and what to drop, and the build starts from there.',
  },
];
---
<Base title="How I'd Build Your Outbound Engine · Victoria Kallsen" description="The phases, deliverables and timeline for building a signal-based outbound engine: ICP and signals, sourcing, scoring, contact capture, messaging, deliverability, tracking and iteration.">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Engagement plan</p>
      <h1>How I'd build your outbound engine</h1>
      <p class="lede">A system that finds accounts showing a real reason to buy, puts the right person and a drafted message in front of your reps every morning, and learns from every reply. Here is how we would get there, phase by phase.</p>
      <div class="actions">
        <a class="btn" href={bookingUrl}>Talk it through</a>
        <a class="btn ghost" href="#phases">See the phases</a>
      </div>
      <div class="outcomes">
        <div><strong>Every morning</strong><span>A ranked list of who to contact, why now, and a draft to send</span></div>
        <div><strong>Every account</strong><span>A score with a plain-English reason behind it</span></div>
        <div><strong>Every week</strong><span>Which signals got replies, and what changes as a result</span></div>
      </div>
    </div>
  </section>

  <section id="phases" class="band">
    <div class="wrap">
      <p class="eyebrow">The build</p>
      <h2>Eight phases, about four weeks to first sends</h2>
      <p class="lede" style="margin-bottom:32px">A typical timeline. Email warmup is usually what sets the pace, so it starts in week 2 while the rest is built.</p>
      <ol class="phases">
        {phases.map((p) => (
          <li class="card phase">
            <div class="phase-head">
              <span class="pnum">{p.n}</span>
              <h3>{p.name}</h3>
              <span class="when">{p.when}</span>
            </div>
            <p>{p.what}</p>
            <dl>
              <div><dt>You get</dt><dd>{p.get}</dd></div>
              <div><dt>I need from you</dt><dd>{p.need}</dd></div>
            </dl>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="proof">
    <div class="wrap">
      <p class="eyebrow">Not a theory</p>
      <h2>Built on the engine I run for my own outbound</h2>
      <p class="lede" style="margin-bottom:28px">I find my own clients with this same system. It is a small web app I built and use every day, so the plan above comes from running it, not from a slide.</p>
      <ol class="flow-row" aria-label="How the engine works">
        {flow.map((f) => (
          <li class="card">
            <span class="num">{f.label}</span>
            <ul>{f.items.map((i) => <li>{i}</li>)}</ul>
          </li>
        ))}
      </ol>
      <div class="proof-grid">
        <div>
          <h3>What's under the hood</h3>
          <p>A Next.js app on Vercel with a Postgres database on Supabase. A daily scheduled job checks each account's public job board across 12 applicant-tracking systems, with a fallback that reads the careers page. A twice-weekly job finds new companies that fit and imports them. A one-click browser button saves a LinkedIn or Sales Navigator page I'm already viewing, and Claude reads it to fill in headcount, funding, new sales leaders and the best contact.</p>
          <div class="tools"><span>Next.js</span><span>Supabase Postgres</span><span>Vercel cron</span><span>Claude</span><span>Chrome extension</span></div>
        </div>
        <div>
          <h3>What I learned building it</h3>
          <ul class="learned">
            <li>An open sales leader role is a "wait" signal, not a buy signal. Teams rarely bring in outside help until that leader is in the seat.</li>
            <li>Job titles need care. Customer success and account management roles look like sales hiring and aren't.</li>
            <li>Some job boards have no public feed, so the system says so instead of guessing.</li>
            <li>Paid contact lookups are easy to overspend on. Capturing the person while you're already on their profile is cheaper and more accurate.</li>
          </ul>
        </div>
      </div>
      <p class="fine"><a href="/work/building-my-outbound-engine/">Read the full build write-up →</a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Principles</p>
      <h2>How I build it</h2>
      <div class="grid principles">
        <div class="card"><h3>Your stack first</h3><p>I build on the CRM and tools you already pay for, and only add something new when it clearly earns its cost.</p></div>
        <div class="card"><h3>Signals you can check</h3><p>Every score traces back to something a rep can see, like a job post or an announcement, not a black-box intent number.</p></div>
        <div class="card"><h3>People send</h3><p>The system does the research and drafting. Reps make the call on every message, and LinkedIn is never automated.</p></div>
        <div class="card"><h3>You own it</h3><p>Code, data and accounts live with you, documented so the system outlasts the engagement.</p></div>
      </div>
    </div>
  </section>

  <section id="working-together">
    <div class="wrap">
      <p class="eyebrow">Working together</p>
      <h2>Three stages, each scoped up front</h2>
      <p class="lede" style="margin-bottom:28px">You can stop after any stage and keep everything built so far.</p>
      <div class="stages">
        {stages.map((s, i) => (
          <div class="card">
            <span class="tag">Stage {i + 1} · {s.length}</span>
            <h3>{s.name}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Questions</p>
      <h2>Common questions</h2>
      <div class="faqs">
        {faqs.map((f) => (
          <details class="card">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="cta">
        <h2>Want this for your team?</h2>
        <p class="lede">Tell me who you sell to. I'll come back with the signals I'd build on first and what the first four weeks would look like.</p>
        <div class="actions"><a class="btn" href={bookingUrl}>Book a 20-minute call</a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .band { background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .band .card { background: var(--bg); }
  .num { font-size: 12px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: .06em; }
  .fine { font-size: 15px; color: var(--muted); margin-top: 20px; }

  .outcomes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 40px; }
  .outcomes div { border-top: 2px solid var(--accent); padding-top: 12px; }
  .outcomes strong { display: block; font-size: 16px; }
  .outcomes span { color: var(--muted); font-size: 15px; }

  .phases { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .phase { padding: 22px; gap: 12px; }
  .phase > p { font-size: 15px; }
  .phase-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .phase-head h3 { font-size: 19px; }
  .pnum { width: 28px; height: 28px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 14px; display: inline-grid; place-items: center; flex-shrink: 0; }
  .when { margin-left: auto; font-size: 12px; font-weight: 600; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px; white-space: nowrap; }
  .phase dl { margin: 4px 0 0; display: grid; gap: 10px; }
  .phase dl div { border-top: 1px solid var(--border); padding-top: 10px; }
  .phase dt { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--accent); }
  .phase dd { margin: 2px 0 0; font-size: 14px; color: var(--text); }

  .flow-row { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; }
  .flow-row > li { padding: 14px; gap: 8px; position: relative; }
  .flow-row > li:not(:last-child)::after { content: '→'; position: absolute; right: -10px; top: 50%; transform: translate(50%, -50%); color: var(--accent); font-weight: 700; font-size: 14px; }
  .flow-row ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .flow-row ul li { font-size: 13px; color: var(--muted); line-height: 1.4; }

  .proof-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 36px; }
  .proof-grid h3 { margin: 0 0 10px; font-size: 19px; }
  .proof-grid p { color: var(--muted); font-size: 16px; margin: 0 0 14px; }
  .learned { margin: 0; padding-left: 20px; color: var(--muted); font-size: 16px; display: flex; flex-direction: column; gap: 8px; }

  .principles { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .principles .card h3 { font-size: 18px; }
  .principles .card p { font-size: 15px; }

  .stages { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .stages .card p { font-size: 15px; }

  .faqs { display: flex; flex-direction: column; gap: 10px; max-width: 760px; }
  .faqs details { padding: 16px 20px; gap: 0; }
  .faqs summary { cursor: pointer; font-weight: 600; }
  .faqs details p { margin-top: 10px; font-size: 15px; }

  @media (max-width: 980px) {
    .flow-row { grid-template-columns: repeat(4, 1fr); }
    .flow-row > li:nth-child(4)::after { display: none; }
  }
  @media (max-width: 820px) {
    .phases, .proof-grid, .stages, .outcomes { grid-template-columns: 1fr; }
    .outcomes { gap: 12px; }
  }
  @media (max-width: 560px) {
    .flow-row { grid-template-columns: 1fr 1fr; }
    .flow-row > li::after { display: none; }
    .when { margin-left: 0; }
  }
</style>
