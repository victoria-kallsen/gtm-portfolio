---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const {
  title = 'Victoria Kallsen · GTM Engineer',
  description = 'GTM engineering for B2B teams: signal-based outbound, enrichment, routing and stack consolidation.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="name" href="/">Victoria Kallsen</a>
        <nav>
          <a href="/#work">Work</a>
          <a href="/signals/">Signal map</a>
          <a href="/stack-audit/">Stack audit</a>
          <a href="/account-brief/">Live demo</a>
          <a href="/#contact">Contact</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer><div class="wrap">© {new Date().getFullYear()} Victoria Kallsen</div></footer>
  </body>
</html>
