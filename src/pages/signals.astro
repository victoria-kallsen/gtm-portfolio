---
import Base from '../layouts/Base.astro';
import { signals, tools } from '../data/signals';
const toolByName = Object.fromEntries(tools.map((t) => [t.name, t]));
const types = [...new Set(tools.map((t) => t.type))];
---
<Base title="GTM Signal Map · Victoria Kallsen" description="Which sales tools provide which buying signals: hiring, funding, intent, web visits, job changes, tech installs and more.">
  <section>
    <div class="wrap">
      <p class="eyebrow">Guide</p>
      <h1>The GTM signal map</h1>
      <p class="lede">Which tools actually give you which buying signals. Pick a signal to see where to get it, or filter by tool type to see what each category covers.</p>

      <div class="filters" role="group" aria-label="Filter by signal">
        <button class="chip on" data-signal="all">All signals</button>
        {signals.map((s) => <button class="chip" data-signal={s.id}>{s.name}</button>)}
      </div>
      <div class="filters" role="group" aria-label="Filter by tool type">
        <button class="chip small on" data-type="all">All tool types</button>
        {types.map((t) => <button class="chip small" data-type={t}>{t}</button>)}
      </div>

      <div class="signal-list">
        {signals.map((s) => (
          <div class="card signal" data-id={s.id}>
            <h3>{s.name}</h3>
            <p>{s.why}</p>
            <ul class="sources">
              {s.sources.map((src) => (
                <li data-type={toolByName[src.tool]?.type}>
                  <strong>{src.tool}</strong>
                  <span class="ttype">{toolByName[src.tool]?.type}</span>
                  <span class="how">{src.how}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>The tools, at a glance</h2>
      <p class="lede" style="margin-bottom:24px">The biggest source of confusion: Clay is an orchestrator that pulls from many providers, while 6sense and Demandbase are platforms with their own data. They solve different problems, and many teams use both.</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tool</th><th>Type</th><th>What it's for</th><th>Pricing model</th></tr></thead>
          <tbody>
            {tools.map((t) => (
              <tr><td><strong>{t.name}</strong></td><td>{t.type}</td><td>{t.blurb}</td><td>{t.pricing}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">Last reviewed November 2026. Vendors change fast, so if something here is out of date, tell me.</p>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="cta">
        <h2>Not sure which signals matter for you?</h2>
        <p class="lede">I'll map your ICP to the 3 or 4 signals worth paying for, and the cheapest way to get them.</p>
        <div class="actions"><a class="btn" href="/#contact">Book a call</a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .chip { font: inherit; font-size: 14px; border: 1px solid var(--border); background: var(--surface); color: var(--text); padding: 7px 14px; border-radius: 999px; cursor: pointer; }
  .chip.small { font-size: 13px; padding: 5px 12px; color: var(--muted); }
  .chip.on { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .signal-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-top: 32px; }
  .signal[hidden] { display: none; }
  .sources { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .sources li { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; font-size: 15px; border-top: 1px solid var(--border); padding-top: 10px; }
  .sources li[hidden] { display: none; }
  .ttype { justify-self: end; font-size: 12px; color: var(--accent); }
  .how { grid-column: 1 / -1; color: var(--muted); font-size: 14px; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  table { border-collapse: collapse; width: 100%; font-size: 15px; min-width: 640px; }
  th, td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { font-size: 13px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  td:nth-child(3) { color: var(--muted); }
  .fine { font-size: 14px; color: var(--muted); margin-top: 16px; }
  @media (max-width: 600px) { .signal-list { grid-template-columns: 1fr; } }
</style>

<script>
  let sig = 'all', type = 'all';
  const apply = () => {
    document.querySelectorAll<HTMLElement>('.signal').forEach((card) => {
      const items = [...card.querySelectorAll<HTMLElement>('li')];
      items.forEach((li) => (li.hidden = type !== 'all' && li.dataset.type !== type));
      const anyVisible = items.some((li) => !li.hidden);
      card.hidden = (sig !== 'all' && card.dataset.id !== sig) || !anyVisible;
    });
  };
  const wire = (attr: 'signal' | 'type') => {
    const chips = document.querySelectorAll<HTMLButtonElement>(`[data-${attr}]`);
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.classList.toggle('on', x === c));
      if (attr === 'signal') sig = c.dataset.signal!; else type = c.dataset.type!;
      apply();
    }));
  };
  wire('signal'); wire('type');
</script>
